@using System.Globalization
@using HomeCalendar = CalendarApp.Features.Home.Data.HebrewCalendar
@using HebrewDay = CalendarApp.Features.Home.Data.HebrewDay
@* HomeCalendar avoids the clash with System.Globalization.HebrewCalendar. *@

<div class="calendar">

	<div class="weekdays">
		@foreach (var name in WeekdayNames)
		{
			<div class="weekday">@name</div>
		}
	</div>

	<div class="days">
		@foreach (var day in Days)
		{
			var besideYom = day.Overlay.Where(BesideYom).ToList();
			var overlay = day.Overlay.Where(item => !BesideYom(item)).ToList();
			<div class="day-cell @(day.IsCurrentMonth ? "" : "other-month") @(day.IsToday ? "today" : "")">
				@if (day.DayOf.Count > 0)
				{
					<div class="corner corner-left">
						@foreach (var item in day.DayOf)
						{
							<span class="@item.Css" title="@item.Title" aria-label="@AccessibleName(item)">
								@if (string.IsNullOrEmpty(item.TextXs))
								{
									@item.Text
								}
								else
								{
									<span class="label-xs">@item.TextXs</span>
									<span class="label-sm">@item.Text</span>
								}
							</span>
						}
					</div>
				}
				@if (day.Erev.Count > 0)
				{
					<div class="corner corner-right">
						@foreach (var item in day.Erev)
						{
							<span class="@item.Css" title="@item.Title" aria-label="@item.Title">
								<i class="@item.Icon" aria-hidden="true"></i>
							</span>
						}
					</div>
				}
				<div class="day-number-bg">@day.Date.Day</div>
				@if (overlay.Count > 0)
				{
					<div class="biblical-overlay">
						<div class="overlay-line">
							@foreach (var item in overlay)
							{
								<span class="@item.Css" title="@item.Title" aria-label="@AccessibleName(item)">
									@if (!string.IsNullOrEmpty(item.Icon))
									{
										<i class="@item.Icon me-1" aria-hidden="true"></i>
									}
									@if (string.IsNullOrEmpty(item.TextXs))
									{
										@item.Text
									}
									else
									{
										<span class="label-xs">@item.TextXs</span>
										<span class="label-sm">@item.Text</span>
									}
								</span>
							}
						</div>
					</div>
				}
				@if (day.Yom is not null || besideYom.Count > 0)
				{
					<div class="yom-row">
						@foreach (var item in besideYom)
						{
							<span class="yom-count @item.Css" title="@item.Title">@item.Text</span>
						}
						@if (day.Yom is int yom)
						{
							<span class="yom-badge @day.YomClass" title="Hebrew day @yom">@yom</span>
						}
					</div>
				}
			</div>
		}
	</div>
	<AbbreviationTable />

</div>





@code {
	[Parameter, EditorRequired] public DateOnly CurrentDate { get; set; }

	private readonly List<CalendarDay> Days = [];
	private string? earlierMonth;
	private string? laterMonth;
	private readonly Dictionary<DateOnly, CornerMark> omerByDate = [];

	private static readonly string[] WeekdayNames =
		CultureInfo.InvariantCulture.DateTimeFormat.AbbreviatedDayNames;

	protected override void OnParametersSet()
	{
		var labels = HomeCalendar.LabelsFor(CurrentDate);
		earlierMonth = labels.Earlier;
		laterMonth = labels.Later;
		GenerateDays();
	}

	private void IndexOmer(DateOnly first, DateOnly last)
	{
		omerByDate.Clear();
		for (var date = first; date <= last; date = date.AddDays(1))
		{
			var day = HomeCalendar.For(date);
			foreach (var count in day.Counts)
			{
				if (count.Title != DayCount.Omer.Title || !TryCount(count.Text, out var number, out _))
				{
					continue;
				}

				var match = day.Events.FirstOrDefault(item => item.Text == EventFlag.Omer.Title);
				omerByDate[day.Date] = new CornerMark(
					Readable(match?.BadgeCss ?? count.BadgeCss),
					null,
					number.ToString(CultureInfo.InvariantCulture),
					count.Title);
			}
		}
	}

	private void GenerateDays()
	{
		Days.Clear();
		var year = CurrentDate.Year;
		var month = CurrentDate.Month;
		if (year < 1 || month is < 1 or > 12)
		{
			return;
		}

		var first = new DateOnly(year, month, 1);
		var start = first.AddDays(-(int)first.DayOfWeek);
		var today = DateOnly.FromDateTime(DateTime.Today);
		IndexOmer(start, start.AddDays(42));
		for (var i = 0; i < 42; i++)
		{
			var date = start.AddDays(i);
			var hebrew = HomeCalendar.For(date);
			var overlay = new List<CornerMark>(OverlayMarks(hebrew));
			if (omerByDate.TryGetValue(date, out var omer))
			{
				overlay.Add(omer);
			}

			Days.Add(new CalendarDay(
				date,
				date.Month == month,
				date == today,
				hebrew.Yom,
				hebrew.MonthName is null ? "" : YomClass(hebrew.MonthName),
				DayOfMarks(hebrew, date),
				ErevMarks(date),
				overlay));
		}
	}

	private List<CornerMark> DayOfMarks(HebrewDay day, DateOnly date)
	{
		var marks = new List<CornerMark>();
		if (day.Events.Any(item => item.Text == EventFlag.RoshKodesh.Title))
		{
			marks.Add(new CornerMark(FeastGroupBadgeColor.RoshKodesh, null, EventFlag.RoshKodesh.Title, EventFlag.RoshKodesh.Title, ShortTitle(EventFlag.RoshKodesh.Title)));
		}

		foreach (var sabbath in HighSabbaths(day))
		{
			marks.Add(new CornerMark(sabbath.Css, null, sabbath.Text, sabbath.Title, sabbath.TitleXs));
		}

		if (OmerEdge(date) is { } omer)
		{
			marks.Add(new CornerMark(omer.Css, null, DayCount.Omer.Title, FeastDay.Omer.Details, ShortTitle(DayCount.Omer.Title)));
		}

		return marks;
	}

	private IReadOnlyList<CornerMark> ErevMarks(DateOnly date)
	{
		var marks = new List<CornerMark>();
		var next = HomeCalendar.For(date.AddDays(1));
		if (next.Events.Any(item => item.Text == EventFlag.RoshKodesh.Title))
		{
			marks.Add(new CornerMark(FeastGroupBadgeColor.RoshKodesh, "fa-regular fa-circle", null, EventFlag.RoshKodesh.Title));
		}

		foreach (var sabbath in HighSabbaths(next))
		{
			if (string.IsNullOrWhiteSpace(sabbath.Icon))
			{
				continue;
			}

			marks.Add(new CornerMark(sabbath.Css, sabbath.Icon, null, sabbath.Text));
		}

		if (OmerEdge(date.AddDays(1)) is { } omer)
		{
			marks.Add(new CornerMark(omer.Css, FeastDay.Omer.Icon, null, DayCount.Omer.Title));
		}

		return marks;
	}

	private CornerMark? OmerEdge(DateOnly date)
	{
		if (!omerByDate.TryGetValue(date, out var omer)
			|| !int.TryParse(omer.Text, NumberStyles.None, CultureInfo.InvariantCulture, out var number)
			|| (number != 1 && number != DayCount.Omer.TotalDays))
		{
			return null;
		}

		return omer;
	}

	private static IReadOnlyList<CornerMark> OverlayMarks(HebrewDay day)
	{
		var marks = new List<CornerMark>();
		foreach (var item in day.Events)
		{
			if (IsCornerEvent(item.Text) || DayCount.IsAweOrRepentance(item.Text))
			{
				continue;
			}

			marks.Add(new CornerMark(item.BadgeCss, item.Icon, item.Text, item.Details, ShortTitle(item.Text)));
		}

		foreach (var count in day.Counts)
		{
			if (count.Title == DayCount.Omer.Title || DayCount.IsAweOrRepentance(count.Title))
			{
				continue;
			}

			if (!IsSplitCount(count.Title))
			{
				marks.Add(new CornerMark(count.BadgeCss, null, count.Text, count.Title));
				continue;
			}

			if (TryCount(count.Text, out var number, out _))
			{
				marks.Add(new CornerMark(Solid(count.BadgeCss), null, number.ToString(CultureInfo.InvariantCulture), count.Title));
			}
		}

		return marks;
	}

	private static List<HighSabbath> HighSabbaths(HebrewDay day)
	{
		var list = new List<HighSabbath>();
		foreach (var count in day.Counts)
		{
			if (!IsSplitCount(count.Title) || !TryCount(count.Text, out var number, out var total) || !IsEdge(number, total))
			{
				continue;
			}

			var match = day.Events.FirstOrDefault(item => item.Text == count.Title);
			list.Add(new HighSabbath(
				Solid(match?.BadgeCss ?? count.BadgeCss),
				match?.Icon,
				count.Title,
				string.IsNullOrEmpty(match?.Details) ? count.Title : match.Details,
				ShortTitle(count.Title)));
		}

		foreach (var item in day.Events)
		{
			if (item.Text == EventFlag.Shavuot.Title
				|| item.Text == EventFlag.YomTeruah.Title
				|| item.Text == EventFlag.YomKippur.Title)
			{
				list.Add(new HighSabbath(item.BadgeCss, item.Icon, item.Text, item.Details, ShortTitle(item.Text)));
			}
		}

		return list;
	}

	private string YomClass(string name)
	{
		if (name == earlierMonth)
		{
			return "badge bg-pink";
		}

		if (name == laterMonth)
		{
			return "badge bg-purple";
		}

		return "badge bg-secondary";
	}

	private static bool IsCornerEvent(string title) =>
		title == EventFlag.RoshKodesh.Title
		|| title == EventFlag.Shavuot.Title
		|| title == EventFlag.YomTeruah.Title
		|| title == EventFlag.YomKippur.Title
		|| title == EventFlag.Matzot.Title
		|| title == EventFlag.Sukkot.Title
		|| title == EventFlag.Hanukkah.Title
		|| title == EventFlag.Omer.Title;

	private static bool IsSplitCount(string title) =>
		title == DayCount.UnleavenedBread.Title
		|| title == DayCount.Sukkot.Title
		|| title == DayCount.MenorahCount.Title;

	private static bool BesideYom(CornerMark item)
	{
		if (item.Title == DayCount.UnleavenedBread.Title
			|| item.Title == DayCount.Sukkot.Title
			|| item.Title == DayCount.Omer.Title)
		{
			return true;
		}

		return item.Title == DayCount.MenorahCount.Title
			&& int.TryParse(item.Text, NumberStyles.None, CultureInfo.InvariantCulture, out var number)
			&& (number == 1 || number == DayCount.MenorahCount.TotalDays);
	}

	private static bool IsEdge(int number, int total) =>
		number == 1 || number == total;

	private static bool TryCount(string text, out int number, out int total)
	{
		number = 0;
		total = 0;
		var slash = text.IndexOf('/');
		if (slash <= 0 || slash >= text.Length - 1)
		{
			return false;
		}

		return int.TryParse(text[..slash], NumberStyles.None, CultureInfo.InvariantCulture, out number)
			&& int.TryParse(text[(slash + 1)..], NumberStyles.None, CultureInfo.InvariantCulture, out total)
			&& total > 0;
	}

	private static string Solid(string css) =>
		css.Replace("-subtle", "", StringComparison.Ordinal)
			.Replace("text-black-50", "text-black", StringComparison.Ordinal);

	private static string Readable(string css) =>
		css.Replace("text-black-50", "text-black", StringComparison.Ordinal);

	private static string? ShortTitle(string title)
	{
		if (!EventFlag.TryFromTitle(title, out var flag)
			|| string.Equals(flag.TitleXs, flag.Title, StringComparison.Ordinal))
		{
			return null;
		}

		return flag.TitleXs;
	}

	private static string? AccessibleName(CornerMark item) =>
		string.IsNullOrEmpty(item.TextXs) ? null : item.Text;

	private sealed record CalendarDay(
		DateOnly Date,
		bool IsCurrentMonth,
		bool IsToday,
		int? Yom,
		string YomClass,
		IReadOnlyList<CornerMark> DayOf,
		IReadOnlyList<CornerMark> Erev,
		IReadOnlyList<CornerMark> Overlay);

	private sealed record CornerMark(string Css, string? Icon, string? Text, string Title, string? TextXs = null);

	private sealed record HighSabbath(string Css, string? Icon, string Text, string Title, string? TitleXs);

}
