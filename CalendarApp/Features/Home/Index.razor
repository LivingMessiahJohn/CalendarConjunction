@page "/"

<PageHeader PageEnum="Nav.Home" />

@if (IsCurrentDateInRange())
{
	<Header CurrentDate="CurrentDate" OnDateChanged="ReturnedDate" />

	<MonthCalendar CurrentDate="CurrentDate" />
}
else
{
	<Alert AlertType="alert-danger">Current date is out of range</Alert>
	@* ToDo: show the current date, and the range in the alert message *@
}

@code {

	protected DateOnly CurrentDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
	//protected DateOnly CurrentDate { get; set; } = new DateOnly(1924, 1, 1); // Test out of range date

	private bool IsCurrentDateInRange() =>
		CurrentDate >= YearHelper.MinDate && CurrentDate <= YearHelper.MaxDate;

	private void ReturnedDate(DateOnly date)
	{
		CurrentDate = date;
	}
}
