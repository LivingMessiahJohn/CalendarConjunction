@if (Items.Count > 0)
{
	<div class="xs-legend ms-3">
	<TableTemplate TItem="EventFlag"
								 Items="Items"
								 Caption="Abbreviation Legend"
								 HeaderCSS="table table-sm table-striped align-middle caption-top">
		<TableHeader>
			<th scope="col">Abbr.</th>
			<th scope="col">Event</th>
		</TableHeader>
		<RowTemplate>
			<td><span class="@context.BadgeCss">@context.TitleXs</span></td>
			<td>@context.Title</td>
		</RowTemplate>
	</TableTemplate>
	</div>
}

@code {
	[Parameter] public IReadOnlyList<EventFlag> Items { get; set; } = [];
}
