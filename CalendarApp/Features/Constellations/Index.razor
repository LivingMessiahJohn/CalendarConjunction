@page "/constellations"
@using Markdig
@inject IWebHostEnvironment Environment

<PageHeader PageEnum="Nav.Constellations" LinkHref="/" LinkText="Home" />

<article class="constellations-page mx-auto">

	<h3 class="text-center text-primary mt-4">The Twelve Signs of the Mazzaroth (Zodiac)</h3>
	<ConstellationTable Items="ConstellationDTO.All" />
	<h3 class="text-center text-primary mt-4">The 36 Decans</h3>
	<p>
		The 36 decans (three secondary constellations per zodiac sign) in the Mazzaroth / Gospel-in-the-Stars tradition.
		etymology of <a href="https://www.etymonline.com/search?q=decan" target="_blank">decan</a>
		Not to be confused with <a href="https://www.etymonline.com/search?q=deacan" target="_blank">deacan</a>
	</p>

	<DecanTable Items="DecanDTO.All" />

	<h3 class="text-center text-primary mt-3">Constellations Specifically Named in the Bible</h3>
	<BibleNamedConstellationsTable Items="BibleNamedConstellationsDTO.All" />

	<ConstellationsPhotoAlbum />

</article>

