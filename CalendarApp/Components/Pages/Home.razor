@page "/"

<PageHeader LinkHref="/about" LinkText="About" Icon="fa-solid fa-circle-info" />

<MenuCard FilteredCount="FilteredCount" DateSelection="dateFilter" Events="EventFlag.SelectedTitles(eventFilter)" OpenDateFilter="ShowDateFilter" OpenEventFilter="ShowEventFilter" />

@if (loadError is not null)
{
	<div class="alert alert-danger" role="alert">@loadError</div>
}
else if (rows is null)
{
	<p>Loading calendar…</p>
}
else
{
	<DateFilterModal Visible="dateFilterOpen" Closed="HideDateFilter" Selection="dateFilter" FilterChanged="OnDateFilterChanged" />

	<EventFilterModal Visible="eventFilterOpen" Closed="HideEventFilter" Choices="eventChoices" Selection="eventFilter" FilterChanged="OnEventFilterChanged" />

	<Grid @ref="grid" Year="dateFilter.Year" ItemsProvider="ProvideItems" />
}

@code {
	private Grid? grid;

	private IReadOnlyList<CalendarGridRow>? rows;
	private string? loadError;
	private DateFilterSelection dateFilter = new(YearEnum.All);
	private bool dateFilterOpen;
	private bool eventFilterOpen;
	private int eventFilter = EventFlag.DefaultMask;
	private IReadOnlyList<EventBadge> eventChoices = [];

	private int FilteredCount => FilteredRows().Count();

	private IEnumerable<CalendarGridRow> FilteredRows() => (rows ?? []).Where(row =>
			(dateFilter.Year == YearEnum.All || row.Year == (int)dateFilter.Year)
			&& EventFlag.Matches(eventFilter, row.Events.Select(item => item.Text)));

	private ValueTask<GridItemsProviderResult<CalendarGridRow>> ProvideItems(GridItemsProviderRequest<CalendarGridRow> request)
	{
		var items = FilteredRows().ToList();
		var count = request.Count ?? items.Count;
		var page = items.Skip(request.StartIndex).Take(count).ToList();
		return ValueTask.FromResult(GridItemsProviderResult.From<CalendarGridRow>(page, items.Count));
	}

	protected override void OnInitialized()
	{
		try
		{
			rows = ConstantCalendar.Build();
			dateFilter = new DateFilterSelection(YearDefault.For(DateOnly.FromDateTime(DateTime.Today)));
			eventChoices = DistinctEvents(rows);
		}
		catch (Exception ex)
		{
			loadError = ex.Message;
		}
	}

	private static IReadOnlyList<EventBadge> DistinctEvents(IReadOnlyList<CalendarGridRow> source)
	{
		var order = new List<string>();
		var icons = new Dictionary<string, string?>(StringComparer.Ordinal);
		var details = new Dictionary<string, string>(StringComparer.Ordinal);
		var cssCounts = new Dictionary<string, Dictionary<string, int>>(StringComparer.Ordinal);
		foreach (var row in source)
		{
			foreach (var item in row.Events)
			{
				if (!cssCounts.TryGetValue(item.Text, out var counts))
				{
					counts = new Dictionary<string, int>(StringComparer.Ordinal);
					cssCounts[item.Text] = counts;
					icons[item.Text] = item.Icon;
					details[item.Text] = item.Details;
					order.Add(item.Text);
				}

				counts[item.BadgeCss] = counts.TryGetValue(item.BadgeCss, out var count) ? count + 1 : 1;
			}
		}

		return order
				.Select(text => new EventBadge(text, cssCounts[text].MaxBy(pair => pair.Value).Key, icons[text], details[text]))
				.ToList();
	}

	private void ShowDateFilter() => dateFilterOpen = true;

	private void HideDateFilter() => dateFilterOpen = false;

	private void ShowEventFilter() => eventFilterOpen = true;

	private void HideEventFilter() => eventFilterOpen = false;

	private Task OnDateFilterChanged(DateFilterSelection selection)
	{
		dateFilter = selection;
		return RefreshGrid();
	}

	private Task OnEventFilterChanged(int selection)
	{
		eventFilter = selection;
		return RefreshGrid();
	}

	private async Task RefreshGrid()
	{
		if (grid is not null)
		{
			await grid.RefreshAsync();
		}
	}
}
