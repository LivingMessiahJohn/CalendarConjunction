<PageTitle>@Title</PageTitle>

<div class="page-header d-flex align-items-center mt-2 mb-3 @BorderCSS">
	<div class="page-header-side d-flex align-items-center flex-nowrap gap-2 @(string.IsNullOrEmpty(SecondLeadingLinkText) ? null : "page-header-links")">
		@if (!string.IsNullOrEmpty(LeadingLinkText))
		{
			<a class="btn btn-outline-secondary @PrintLinkClass" href="@LeadingLinkHref">@LeadingLinkText</a>
		}
		@if (!string.IsNullOrEmpty(SecondLeadingLinkText))
		{
			<a class="btn btn-outline-secondary @PrintLinkClass" href="@SecondLeadingLinkHref">
				@if (!string.IsNullOrEmpty(SecondLeadingLinkIcon))
				{
					<i class="@SecondLeadingLinkIcon me-1" aria-hidden="true"></i>
				}
				@SecondLeadingLinkText
			</a>
		}
	</div>
	<h1 class="flex-grow-1 fs-2 text-center mb-0"><i class="@Icon"></i>&nbsp;&nbsp;@Title</h1>
	<div class="page-header-side text-end">
		@if (!string.IsNullOrEmpty(LinkText))
		{
			<a class="btn btn-outline-secondary @PrintLinkClass" href="@LinkHref">@LinkText</a>
		}
	</div>
</div>

@code {
	[Parameter] public string Title { get; set; } = "Conjunction Calendar";
	[Parameter] public string? BorderCSS { get; set; } = "border-bottom border-info";
	[Parameter] public string Icon { get; set; } = "far fa-calendar-check";
	[Parameter] public string? LeadingLinkHref { get; set; }
	[Parameter] public string? LeadingLinkText { get; set; }
	[Parameter] public string? SecondLeadingLinkHref { get; set; }
	[Parameter] public string? SecondLeadingLinkText { get; set; }
	[Parameter] public string? SecondLeadingLinkIcon { get; set; }
	[Parameter] public string? LinkHref { get; set; }
	[Parameter] public string? LinkText { get; set; }
	[Parameter] public bool HideLinksOnPrint { get; set; }

	private string? PrintLinkClass => HideLinksOnPrint ? "d-print-none" : null;
}
