<PageTitle>@Title</PageTitle>

<div class="d-flex align-items-center mt-2 mb-3 @BorderCSS">
	<div class="page-header-side"></div>
	<h1 class="flex-grow-1 fs-2 text-center mb-0"><i class="@Icon"></i>&nbsp;&nbsp;@Title</h1>
	<div class="page-header-side text-end">
		@if (!string.IsNullOrEmpty(LinkText))
		{
			<a class="btn btn-outline-secondary" href="@LinkHref">@LinkText</a>
		}
	</div>
</div>

@code {
	[Parameter] public string Title { get; set; } = "Conjunction Calendar";
	[Parameter] public string? BorderCSS { get; set; } = "border-bottom border-info";
	[Parameter] public string Icon { get; set; } = "far fa-calendar-check";
	[Parameter] public string? LinkHref { get; set; }
	[Parameter] public string? LinkText { get; set; }
}
