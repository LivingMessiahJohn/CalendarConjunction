@if (Visible)
{
	<div @ref="modal" class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="date-filter-title" @onclick="Close" @onkeydown="OnKeyDown">
		<div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true">
			<div class="modal-content">
				<div class="modal-header">
					<h2 class="modal-title h5" id="date-filter-title">Date Filter</h2>
					<button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
				</div>
				<div class="modal-body">
					<div class="row g-2 align-items-end">
						<div class="col-auto">
							<SelectorDropDown T="int"
																Options="YearHelper.HebrewYears"
																SelectedOption="Selection"
																SelectedOptionChanged="OnYearChanged"
																OptionLabel="FormatYear"
																LeadingText="All"
																LeadingValue="0"
																LabelText="Year"
																Superscript="@YearHelper.Range"
																Id="year-filter" />
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}

@code {
	[Parameter] public bool Visible { get; set; }
	[Parameter] public EventCallback Closed { get; set; }
	[Parameter] public int Selection { get; set; }
	[Parameter] public EventCallback<int> FilterChanged { get; set; }

	private ElementReference modal;
	private bool focused;

	private static string FormatYear(int year) => $"{year} - {YearHelper.GetGregorianYear(year)}";

	private Task OnYearChanged(int year)
	{
		Selection = year;
		return FilterChanged.InvokeAsync(year);
	}


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (Visible && !focused)
		{
			focused = true;
			await modal.FocusAsync();
		}
		else if (!Visible)
		{
			focused = false;
		}
	}

	private Task Close() => Closed.InvokeAsync();

	private Task OnKeyDown(KeyboardEventArgs e) =>
			e.Key == "Escape" ? Close() : Task.CompletedTask;


}
