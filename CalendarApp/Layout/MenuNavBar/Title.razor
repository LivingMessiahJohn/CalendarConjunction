<div class="d-block d-sm-none">
	<div class="fs-6 @css" title="XS">@text</div>
</div>
<div class="d-none d-sm-block d-md-none">
	<div class="fs-4 @css" title="SM">@text</div>
</div>
<div class="d-none d-md-block d-lg-none">
	<div class="fs-2 @css" title="MD min-width: 768px">@text</div>
</div>
<div class="d-none d-lg-block d-xl-none">
	<div class="fs-2 @css" title="LG min-width: 992px">@text</div>
</div>
<div class="d-none d-xl-block d-xxl-none">
	<div class="fs-2 @css" title="XL min-width: 1200px">@text</div>
</div>
<div class="d-none d-xxl-block">
	<div class="fs-2 @css" title="XXL min-width: 1400px">@text</div>
</div>

@code {
	const string text = "Conjunction Calendar"; 
	const string css = "fw-bold flex-fill text-center";
}
